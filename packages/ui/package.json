{
  "name": "@act-jirayut/dsai",
  "version": "1.0.0",
  "description": "DSAI design system: shadcn/ui components on Base UI, for React + Tailwind CSS v4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actko/dsai.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/actko/dsai/tree/main/packages/ui#readme",
  "bugs": "https://github.com/actko/dsai/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./product-card": {
      "types": "./dist/product-card.d.ts",
      "import": "./dist/product-card.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src/components/**/*.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch --emptyOutDir false",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.76.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8"
  }
}
